# Environment Configuration for Cobalt Console
# Copy to .env and adjust values

ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./cobalt.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost"]
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=cobalt
KEYCLOAK_CLIENT_ID=cobalt-console
KEYCLOAK_CLIENT_SECRET=change-me-in-production
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=